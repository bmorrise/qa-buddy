# Optional fine-grained GitHub personal access token for private HTTPS repositories.
# Select only the repositories QA Buddy needs and grant Contents: read-only.
# After changing this value, recreate the worker with:
# docker compose up -d --force-recreate worker
GITHUB_TOKEN=

# Variables listed here are available to the worker. A repository runner only
# receives variables explicitly named in that repository's allowlist.
# NPM_TOKEN=
# GITHUB_IDP_REGISTRY=

# Optional operational overrides.
RUN_HISTORY_LIMIT=20
QA_BUDDY_DATA_DIR=/data
QA_BUDDY_WORKSPACE_DIR=/workspaces
QA_BUDDY_WORKSPACE_VOLUME=qa-buddy-workspaces
